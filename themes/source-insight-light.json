  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#800080"
      }
    },
    {
      "scope": [
        "keyword.other.todo",
        "comment.todo"
      ],
      "settings": {
        "foreground": "#800080"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#800080"
      }
    },
    {
      "scope": "punctuation.definition.directive",
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": [
        "punctuation.separator.pointer-access",
        "punctuation.separator.dot-access"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#a63d00"
      }
    },
    {
      "scope": "string.unquoted.cdata.xml",
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#ff0000"
      }
    },
    {
      "scope": [
        "constant.language.null",
        "constant.language.nil",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#ff0000"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#800080"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "word.operator"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": "keyword.control",
      "settings": {
        "foreground": "#000080"
      }
    },
    {
      "scope": "keyword.control.directive",
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.preprocessor",
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "entity.name.enum",
        "entity.name.namespace",
        "entity.name.constant",
        "entity.name.alias"
      ],
      "settings": {
        "foreground": "#000080"
      }
    },
    {
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": "entity.name.label",
      "settings": {
        "foreground": "#ff0000",
        "fontStyle": "underline"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#0088A2"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#0088A2"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#ff0000"
      }
    },
    {
      "scope": [
        "support.function",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": [
        "support.type",
        "support.class",
        "support.constant",
        "support.variable",
        "support.module"
      ],
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#008000"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#008000",
    "function.definition": "#000080",
    "function.declaration": "#000080",
    "method": "#008000",
    "method.definition": "#000080",
    "method.declaration": "#000080",
    "type": "#008000",
    "type.definition": "#000080",
    "type.declaration": "#000080",
    "interface": "#008000",
    "interface.definition": "#000080",
    "interface.declaration": "#000080",
    "struct": "#008000",
    "struct.definition": "#000080",
    "struct.declaration": "#000080",
    "class": "#008000",
    "class.definition": "#000080",
    "class.declaration": "#000080",
    "enum": "#008000",
    "enum.definition": "#000080",
    "enum.declaration": "#000080",
    "typeParameter": {
      "foreground": "#008000",
      "underline": true
    },
    "typeParameter.definition": {
      "foreground": "#000080",
      "underline": true
    },
    "typeParameter.declaration": {
      "foreground": "#000080",
      "underline": true
    },
    "namespace": "#313131",
    "namespace.definition": "#000080",
    "namespace.declaration": "#000080",
    "variable": "#0088A2",
    "variable.definition": "#000080",
    "variable.declaration": "#000080",
    "variable.globalScope": "#800080",
    "variable.fileScope": "#800080",
    "variable.definition.globalScope": "#000080",
    "variable.definition.fileScope": "#000080",
    "variable.declaration.globalScope": "#000080",
    "variable.declaration.fileScope": "#000080",
    "parameter": "#0088A2",
    "parameter.definition": {
      "foreground": "#000080",
      "underline": true
    },
    "parameter.declaration": {
      "foreground": "#000080",
      "underline": true
    },
    "property": "#008000",
    "property.declaration": "#000080",
    "enumMember": "#ff0000",
    "enumMember.definition": "#000080",
    "enumMember.declaration": "#000080",
    "label": {
      "foreground": "#ff0000",
      "underline": true
    },
    "macro": "#008000",
    "macro.definition": "#000080",
    "macro.declaration": "#000080",
    "operator": "#008000"
  }
}
